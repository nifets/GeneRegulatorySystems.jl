{
    "label": "induction",
    "step": {
        "do": {"{regulation/v1}": {
            "species": ["mrnas", "proteins"],
            "genes": [
                {
                    "$": ["defaults", "gene"],
                    "name": "a",
                    "activation": [{"from": "b", "at": 100.0, "k": -2.0}]
                },
                {
                    "$": ["defaults", "gene"],
                    "name": "b"
                }
            ]
        }},
        "seed": "${rootseed}-induction",
        "step": [
            {"{add}": {"$": ["defaults", "bootstrap"]}},
            {"to": 43200.0},
            {
                "branch": true,
                "step": [
                    {"label": "control", "step": {"to": 10800.0}},
                    {"label": "induced", "step": [
                        {"{add}": {"b.proteins": 500}},
                        {"to": 10800.0}
                    ]}
                ]
            }
        ]
    }
}

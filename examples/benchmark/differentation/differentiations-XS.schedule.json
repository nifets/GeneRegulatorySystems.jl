{
    "note": "31 genes",
    "label": "differentiation_XS",
    "realizations": {"count": 100, "terminals": 6, "periphery_size": 4},
    "replicates": {"count": 60, "to": 129600.0, "step": 3600.0},
    "step": {
        "each": {"length": {"$": ["realizations", "count"]}},
        "as": "i",
        "branch": true,
        "step": {
            "do": {"{regulation/random-differentiation}": {
                "seed": "differentiation-${rootseed}-${i}",
                "differentiation": {
                    "ratios":
                        ["Dirichlet", {"$": ["realizations", "terminals"]}, 5.0],
                    "duration": ["LogNormal", 9.3, 1.0],
                    "differentiator_base_rates":
                        {"$": ["defaults", "differentiation", "differentiator", "base_rates"]},
                    "timer_base_rates":
                        {"$": ["defaults", "differentiation", "timer", "base_rates"]},
                    "trigger_deposit": 500,
                    "timer_deposit": {"mrnas": 5, "proteins": 30},
                    "buffer": [0.002, 0.008],
                    "buffer_deposit": 500
                },
                "peripheral": {
                    "base_rates": {"$": ["defaults", "gene", "base_rates"]},
                    "activation": {
                        "adjacency": {
                            "initiator": [[0.8, 0.3], [0.2, 0.5]],
                            "power": {"$": ["realizations", "periphery_size"]},
                            "expected_links_per_gene": 0.3
                        },
                        "at": ["LogNormal", 2.0, 1.0]
                    },
                    "repression": {
                        "adjacency": {
                            "initiator": [[0.3, 0.6], [0.4, 0.1]],
                            "power": {"$": ["realizations", "periphery_size"]},
                            "expected_links_per_gene": 0.4
                        },
                        "at": ["LogNormal", 2.0, 1.0]
                    }
                },
                "activation": {
                    "count": ["DiscreteNonParametric", [0, 1, 2], [0.5, 0.4, 0.1]],
                    "at": ["LogNormal", 2.0, 1.0]
                },
                "repression": {
                    "count": ["DiscreteNonParametric", [0, 1, 2], [0.6, 0.3, 0.1]],
                    "at": ["LogNormal", 2.0, 1.0]
                }
            }},
            "each": {"length": {"$": ["replicates", "count"]}},
            "as": "j",
            "branch": true,
            "step": [
                {"{add}": {"$": ["defaults", "bootstrap"]}},
                {"{bootstrap/differentiation}": {"$": "do"}},
                {
                    "label": "${label}_${i}_${j}_raw",
                    "to": {"$": ["replicates", "to"]},
                    "step": [
                        {"$": ["replicates", "step"]},
                        {
                            "label": "${label}_${i}_${j}_extracted",
                            "branch": true,
                            "step": [{"{extract-transcriptome-amplified}": {
                                "collect": 0.9, "cycles": 5, "efficiency": 0.8,
                                "dropout": 0.05, "target": 5000.0
                            }}]
                        }
                    ]
                }
            ]
        }
    }
}
